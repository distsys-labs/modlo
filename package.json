{
  "name": "modlo",
  "version": "2.0.0",
  "description": "A dynamic module loader built on fount",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "node --import tsx --test './spec/**/*.spec.ts'",
    "test:watch": "node --import tsx --test --watch './spec/**/*.spec.ts'",
    "test:coverage": "c8 npm test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src spec",
    "prepublishOnly": "npm run build && npm test",
    "release": "standard-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arobson/modlo.git"
  },
  "keywords": [
    "module",
    "fount",
    "loader"
  ],
  "author": "Alex Robson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arobson/modlo/issues"
  },
  "homepage": "https://github.com/arobson/modlo#readme",
  "dependencies": {
    "fast-glob": "^3.3.2",
    "fount": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "c8": "^10.1.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
